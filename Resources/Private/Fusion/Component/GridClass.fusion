# Class names are written out: Tailwind scans source text, a composed name
# like 'grid-cols-' + columns is never found.
prototype(Waterproof.News:Component.GridClass) < prototype(Neos.Fusion:Match) {
    @subject = ${this.columns}
    columns = 'cols3'

    cols1 = 'grid grid-cols-1 gap-8'
    cols2 = 'grid grid-cols-1 gap-8 md:grid-cols-2'
    cols3 = 'grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3'
    cols4 = 'grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4'
    @default = 'grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3'
}
