prototype(Waterproof.News:Content.ArticleList) < prototype(Neos.Neos:ContentComponent) {
    renderer = Neos.Fusion:Join {
        headline = Neos.Fusion:Component {
            _headline = ${q(node).property('headline')}
            renderer = afx`
                <h2 class="mb-10 text-3xl font-bold" @if.hasHeadline={props._headline}>
                    {props._headline}
                </h2>
            `
        }

        list = Flowpack.Listable:PaginatedCollection {
            collection = Waterproof.News:Component.ArticleListCollection
            itemsPerPage = ${q(node).property('itemsPerPage') || 9}
            listRenderer = 'Waterproof.News:Component.ArticleCollection'
            showPreviousNextLinks = true

            @cache.entryDiscriminator = ${'p' + String.toInteger(request.arguments.currentPage || 1)}
            @cache.entryTags {
                1 = ${Neos.Caching.nodeTag(node)}
                2 = ${Neos.Caching.nodeTypeTag('Waterproof.News:Document.Article', documentNode)}
            }
        }

        @process.wrap = ${'<section class="px-4 py-16"><div class="mx-auto max-w-7xl">' + value + '</div></section>'}
    }

    @cache {
        mode = 'cached'
        entryIdentifier {
            node = ${Neos.Caching.entryIdentifierForNode(node)}
        }
        entryTags {
            1 = ${Neos.Caching.nodeTag(node)}
            2 = ${Neos.Caching.nodeTypeTag('Waterproof.News:Document.Article', documentNode)}
            3 = ${Neos.Caching.nodeTypeTag('Waterproof.News:Document.ArticleIndex', documentNode)}
        }
    }
}

prototype(Waterproof.News:Component.ArticleListCollection) < prototype(Neos.Fusion:Value) {
    index = ${q(node).referenceNodes('source').get(0)
        || q(site).find('[instanceof Waterproof.News:Document.ArticleIndex]').get(0)}

    _category = ${q(node).referenceNodes('category').get(0)}

    @context.selectedCategoryName = ${this._category ? this._category.name.value : ''}

    value = ${this.index
        ? Array.filter(
            q(this.index).children('[instanceof Waterproof.News:Document.Article]').sort('publicationDate', 'DESC').get(),
            article => !selectedCategoryName || Array.some(
                Array.map(q(article).referenceNodes('taxonomyReferences').get(), taxon => taxon.name.value),
                assigned => assigned == selectedCategoryName
            )
        )
        : []}
}

prototype(Waterproof.News:Component.ArticleCollection) {
    columns = ${q(node).property('columns') || q(documentNode).property('columns') || 'cols3'}
}
