##
# Übersichtsseite: listet alle Artikel darunter, absteigend nach
# Veröffentlichungsdatum, paginiert über Flowpack.Listable.
#
prototype(Waterproof.News:Document.ArticleIndex) < prototype(Neos.Neos:Page) {
    body {
        content = Waterproof.News:Content.ArticleIndexBody
    }
}

##
# Der eigentliche Listenkörper. Als eigener Prototyp, damit ein Site-Package
# ihn in sein Seitenlayout einsetzen kann, ohne die Seite zu überschreiben.
#
# Die Spaltenzahl liest Component.ArticleCollection selbst aus documentNode,
# damit sie das dynamische Caching der Paginierung überlebt.
#
prototype(Waterproof.News:Content.ArticleIndexBody) < prototype(Neos.Fusion:Component) {
    _articles = ${q(documentNode).children('[instanceof Waterproof.News:Document.Article]').sort('publicationDate', 'DESC')}
    _itemsPerPage = ${q(documentNode).property('itemsPerPage') || 12}

    renderer = afx`
        <Flowpack.Listable:PaginatedCollection
            collection={props._articles}
            itemsPerPage={props._itemsPerPage}
            listRenderer="Waterproof.News:Component.ArticleCollection"
            showPreviousNextLinks={true}
        />
    `

    # Ohne Tags bliebe die Liste stehen, bis jemand den Cache leert:
    # Der Seiten-Cache ist nur mit dem Dokumentknoten selbst getaggt, nicht
    # mit seinen Kindern.
    @cache {
        mode = 'cached'
        entryIdentifier {
            node = ${Neos.Caching.entryIdentifierForNode(documentNode)}
        }
        entryTags {
            1 = ${Neos.Caching.descendantOfTag(documentNode)}
            2 = ${Neos.Caching.nodeTag(documentNode)}
        }
    }
}
