{
    "name": "waterproof/neos-news",
    "type": "neos-package",
    "description": "News- und Blog-Paket für Neos CMS 9 auf Basis von Flowpack.Listable und Sitegeist.Taxonomy",
    "license": "MIT",
    "authors": [
        {
            "name": "Dennis Hüttner",
            "email": "dh@waterproof.agency",
            "homepage": "https://waterproof.agency"
        }
    ],
    "require": {
        "neos/neos": "^9.0",
        "neos/fusion-afx": "^9.0",
        "flowpack/listable": "^4.0",
        "sitegeist/taxonomy": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Waterproof\\News\\": "Classes"
        }
    },
    "extra": {
        "neos": {
            "package-key": "Waterproof.News"
        }
    }
}
